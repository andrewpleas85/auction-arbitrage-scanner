# Reverb: optional for public listing reads, but raises rate limits. Personal token from reverb.com/my/api_settings
REVERB_API_TOKEN=

# eBay developer keys (developer.ebay.com) - production keyset
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# Needs eBay approval for Marketplace Insights (the only official sold-price source)
EBAY_USE_MARKETPLACE_INSIGHTS=1

DISCORD_WEBHOOK_URL=

# Tunables (defaults shown)
REVERB_CATEGORIES=pro-audio,amps,synths
POLL_INTERVAL_SECONDS=600
MIN_PROFIT_USD=50
MIN_MARGIN_PCT=35
RESALE_FEE_PCT=13.25
OUTBOUND_SHIPPING_USD=15
# No minimum buy price (auctions open at $1). Buy price above MAX is dropped; resale value below MIN_MARKET is ignored.
MAX_PRICE_USD=1500
MIN_MARKET_VALUE_USD=40
MIN_COMPS=5
ACTIVE_ASK_DISCOUNT=0.85
MAX_COMPS_PER_CYCLE=40
DB_PATH=arbitrage.db

# --- Sprint 2 ---
SOURCES=reverb,shopgoodwill,sgw_jewelry,sgw_fashion,gsa,propertyroom,ebay,govdeals,bstock   # add etsy once Etsy approves the app
# Etsy keyword queries (comma-separated)
ETSY_QUERIES=vintage synthesizer,vintage camera,vintage amplifier
SHOPGOODWILL_CATEGORY_IDS=13,170,7,4   # instruments, cameras, electronics, collectibles
SHOPGOODWILL_PAGES=3
AUCTION_WINDOW_HOURS=2
ENDING_WINDOW_MINUTES=15
ENDING_POLL_SECONDS=60
SHOPGOODWILL_RECENT_PAGES=3
DISCORD_PING_HERE=0
SOLD_COMPS_MAX=10
ALLOW_ACTIVE_COMPS=0
# GovDeals: RSS feed URLs you obtain from the site (comma separated). Empty = disabled.
GOVDEALS_FEED_URLS=
GOVDEALS_HOME_LOCATION=                # e.g. "Denver" - skips freight estimate for local pickup
GOVDEALS_FREIGHT_USD=75
GOVDEALS_BUYER_PREMIUM_PCT=10
# B-Stock: drop exported lot manifests (JSON/CSV) in this dir
BSTOCK_MANIFEST_DIR=manifests
BSTOCK_BUYER_PREMIUM_PCT=10
LOT_HAIRCUT=0.6

# Etsy (keystring from etsy.com/developers/your-apps)
ETSY_API_KEY=
ETSY_SHARED_SECRET=

# --- Sprint 4: government / police-seizure sources ---
GSA_API_KEY=DEMO_KEY                   # DEMO_KEY = 10 requests/hour; a free key from api.data.gov raises it
GSA_MIN_INTERVAL_SECONDS=1800
GSA_BUYER_PREMIUM_PCT=10
GSA_FREIGHT_USD=75                     # most GSA lots are inspection/pickup only
PROPERTYROOM_CATEGORIES=electronics,computers,tools-and-equipment
PROPERTYROOM_PAGES=2
PROPERTYROOM_BUYER_PREMIUM_PCT=15
PROPERTYROOM_SHIPPING_USD=15           # cards don't show shipping; estimate
LOCKED_CONDITION_FACTOR=0.2            # iCloud / Activation Lock / passcode / MDM / bad ESN / for parts (80% haircut)
RISKY_CONDITION_FACTOR=0.6             # untested / as-is / no power / spares
REFURBISHED_CONDITION_FACTOR=1.10      # refurbished / mint
RESALE_FIXED_FEE_USD=0.30
# EBAY_APP_ID is accepted as an alias for EBAY_CLIENT_ID. Test the pipeline without keys: main.py --once --use-mock-comps

# --- Sprint 6: sold data, GSA closing day, watchlist escalation ---
# Real eBay SOLD prices via https://sold-comps.com (free = 100 requests/month; $9/mo = 2,000). Results are
# cached in arbitrage.db so restarts don't spend quota. Without it the scanner falls back to Marketplace
# Insights (if approved) and then DISCOUNTED ACTIVE ASKS, and tags those alerts ACTIVE-ASKS.
SOLDCOMPS_API_KEY=
SOLDCOMPS_CACHE_TTL_HOURS=24
GSA_CLOSING_DAY_INTERVAL_SECONDS=600   # lots closing today are re-read this often (DEMO_KEY: keep >= 600)
WATCHLIST_BID_THRESHOLDS=10,25,50      # re-value a watchlisted auction when its bid crosses these
WATCHLIST_VALUE_FRACTION=0.5           # ...or nears this fraction of its estimated resale value

# eBay Browse API as a SUPPLY source (items to buy). Needs EBAY_CLIENT_ID + EBAY_CLIENT_SECRET; ~5,000 calls/day.
EBAY_QUERIES=oscilloscope,fluke multimeter,vintage camera lens

# Best Buy Products API (developer.bestbuy.com): NEW retail price caps the resale estimate, shown on alerts.
BESTBUY_API_KEY=
RETAIL_CAP_FRACTION=0.85

# Rough replacement cost of parts a listing is missing (title or PropertyRoom page); added to the cost of the deal.
# Defaults: power adapter 25, power cord 8, charger 15, remote 12, stand 20, battery 40, storage drive 35, controller 30, stylus 10
FIX_COSTS=

# --- Precious-metal melt value (no sold comps needed) and designer clothing/bags ---
MELT_ENABLED=1
MELT_PAYOUT_SCRAP=0.85            # what a refiner/dealer pays of melt for scrap jewelry
MELT_PAYOUT_BULLION=0.95
MELT_SHIP_USD=12                  # insured shipping to the refiner
SHOPGOODWILL_JEWELRY_CATEGORY_IDS=353,6      # 353 = Precious Metal Scrap, 6 = Jewelry & Gemstones
SHOPGOODWILL_FASHION_CATEGORY_IDS=103,164,161,162,150,357,154,167   # purses, accessories, shoes, suits, blazers, outerwear
PROPERTYROOM_CATEGORIES=electronics,computers,tools-and-equipment,jewelry,coins,fashion

# --- Liquidity: will it SELL? (heuristic; needs sold data from SoldComps/eBay; calibrates from your own --log-trade/--close-trade) ---
LIQUIDITY_ENABLED=1
MAX_DAYS_TO_SELL=60          # skip items whose expected days-to-sell is reliably longer than this
CARRY_RATE_PER_YEAR=0.25     # cost of money/space/risk while an item sits (shown on alerts)

# --- Cellular devices: risk-adjusted value as a share of a CLEAN-device market comp (government telecom boilerplate rule) ---
TELECOM_FACTOR_CLEAN=1.0        # listing states Clean IMEI / Factory Unlocked
TELECOM_FACTOR_MODERATE=0.5     # nothing verified, or a reset/setup screen with an unverified IMEI
TELECOM_FACTOR_UNVERIFIED=0.2   # government telecom disclaimer, or untested: assume bad ESN / blacklisted / locked (parts value)

# Paid IMEI checks (sickw.com). Only runs when the listing prints a valid IMEI AND the item is worth >= $100.
SICKW_API_KEY=
SICKW_SERVICE_ID=
ENABLE_PAID_IMEI_CHECKS=1

# GovDeals search API key (the public front-end key govdeals.com's own site uses; leave empty to skip that client)
GOVDEALS_MAESTRO_KEY=
